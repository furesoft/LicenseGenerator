<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LicenseGenerator.ViewModels"
             x:Class="LicenseGenerator.Views.SettingsView"
             x:DataType="vm:MainViewModel">
    <ScrollViewer>
        <StackPanel Spacing="12" Margin="16">
            <TextBlock Text="Key-Dateien beim Start automatisch laden" FontWeight="SemiBold"/>
            <TextBlock Text="Wenn die Pfade gesetzt und gespeichert sind, werden Public/Private Key beim Start automatisch geladen."
                       TextWrapping="Wrap"/>

            <Separator />

            <OptionsDisplayItem Header="Public Key"
                                Description="Dateipfad für den automatisch zu ladenden Public Key."
                                Icon="{x:Static MaterialIcons.Key}">
                <OptionsDisplayItem.ActionButton>
                    <Button Content="Auswählen…" Command="{Binding BrowseSettingsPublicKeyPathCommand}" />
                </OptionsDisplayItem.ActionButton>
                <OptionsDisplayItem.Content>
                    <TextBox Text="{Binding SettingsPublicKeyPath}" PlaceholderText="Pfad zur Public Key Datei…" />
                </OptionsDisplayItem.Content>
            </OptionsDisplayItem>

            <OptionsDisplayItem Header="Private Key"
                                Description="Dateipfad für den automatisch zu ladenden Private Key."
                                Icon="{x:Static MaterialIcons.KeyOutline}">
                <OptionsDisplayItem.ActionButton>
                    <Button Content="Auswählen…" Command="{Binding BrowseSettingsPrivateKeyPathCommand}" />
                </OptionsDisplayItem.ActionButton>
                <OptionsDisplayItem.Content>
                    <TextBox Text="{Binding SettingsPrivateKeyPath}" PlaceholderText="Pfad zur Private Key Datei…" />
                </OptionsDisplayItem.Content>
            </OptionsDisplayItem>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Einstellungen speichern" Command="{Binding SaveKeyPathSettingsCommand}" />
                <Button Content="Keys jetzt laden" Command="{Binding LoadKeysFromSettingsCommand}" />
            </StackPanel>

            <Border Background="#1A000000" CornerRadius="4" Padding="10"
                    IsVisible="{Binding SettingsStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding SettingsStatus}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
