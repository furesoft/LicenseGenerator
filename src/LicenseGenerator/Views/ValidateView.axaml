<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LicenseGenerator.ViewModels"
             x:Class="LicenseGenerator.Views.ValidateView"
             x:DataType="vm:MainViewModel">
    <ScrollViewer>
        <StackPanel Spacing="10" Margin="16">

            <TextBlock Text="License XML" FontWeight="SemiBold"/>
            <TextBox Text="{Binding LicenseToValidate}"
                     AcceptsReturn="True" Height="130"
                     FontFamily="Courier New" FontSize="10"
                     PlaceholderText="Paste or load license XML here…" />
            <Button Content="Load license file…" Command="{Binding LoadLicenseForValidationCommand}" />

            <Separator />

            <TextBlock Text="Public Key" FontWeight="SemiBold"/>
            <TextBox Text="{Binding ValidationPublicKey}"
                     AcceptsReturn="True" Height="70"
                     FontFamily="Courier New" FontSize="11"
                    PlaceholderText="Public Key for signature verification…" />
            <Button Content="Use current Public Key"
                    Command="{Binding UseGeneratedPublicKeyForValidationCommand}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="🔍 Validate license" Command="{Binding ValidateLicenseCommand}" />
                <Button Content="📋 View (without signature verification)"
                        Command="{Binding LoadLicenseAndDisplayCommand}" />
            </StackPanel>

            <Border Background="#1A000000" CornerRadius="4" Padding="10"
                    IsVisible="{Binding ValidationResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ValidationResult}"
                           FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>

            <TextBlock Text="License details" FontWeight="SemiBold"
                       IsVisible="{Binding LicenseDetails, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBox Text="{Binding LicenseDetails}"
                     AcceptsReturn="True" Height="220"
                     FontFamily="Courier New" FontSize="11"
                     IsReadOnly="True"
                     IsVisible="{Binding LicenseDetails, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
