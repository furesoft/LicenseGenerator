<PleasantWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="clr-namespace:LicenseGenerator.ViewModels"
                x:Class="LicenseGenerator.Views.ProductSelectionWindow"
                x:DataType="vm:ProductSelectionViewModel"
                Width="420" Height="200" MinWidth="400" MinHeight="190" CanResize="False"
                ShowInTaskbar="True" WindowStartupLocation="CenterOwner"
                Icon="avares://LicenseGenerator/Assets/icon.png"
                Title="Produkt auswählen">
    <Grid RowDefinitions="*,Auto" Margin="16">
        <StackPanel Spacing="10">
            <TextBlock Text="Produkt für diese Sitzung auswählen" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProductName}"
                          PlaceholderText="Produkt auswählen…"
                          HorizontalAlignment="Stretch" />
                <Button Content="+" Width="40" ToolTip.Tip="Neues Produkt anlegen"
                        Click="OnAddProductClicked" />
            </StackPanel>

            <Border Background="#1A000000" CornerRadius="4" Padding="10"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="Abbrechen" Click="OnCancelClicked"/>
            <Button Content="OK" Theme="{DynamicResource AccentButtonTheme}" Click="OnOkClicked"/>
        </StackPanel>
    </Grid>
</PleasantWindow>
