<PleasantWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="clr-namespace:LicenseGenerator.ViewModels"
                x:Class="LicenseGenerator.Views.ProductSelectionWindow"
                x:DataType="vm:ProductSelectionViewModel"
                Width="520"
                Height="300"
                MinWidth="500"
                MinHeight="280"
                CanResize="False"
                ShowInTaskbar="False"
                WindowStartupLocation="CenterOwner"
                Title="Produkt auswählen">
    <Grid RowDefinitions="*,Auto" Margin="16">
        <StackPanel Spacing="10">
            <TextBlock Text="Produkt für diese Sitzung auswählen" FontWeight="SemiBold"/>
            <ComboBox ItemsSource="{Binding Products}"
                      SelectedItem="{Binding SelectedProductName}"
                      PlaceholderText="Produkt auswählen…" />

            <Separator />

            <TextBlock Text="Neues Produkt anlegen" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Width="390"
                         Text="{Binding NewProductName}"
                         PlaceholderText="Produktname…" />
                <Button Content="+"
                        Width="40"
                        Command="{Binding AddProductCommand}" />
            </StackPanel>
            <TextBox PasswordChar="●"
                     Text="{Binding NewProductPassphrase}"
                     PlaceholderText="Passphrase für neues Produkt…" />

            <Border Background="#1A000000" CornerRadius="4" Padding="10"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="Abbrechen" Click="OnCancelClicked"/>
            <Button Content="OK" Theme="{DynamicResource AccentButtonTheme}" Click="OnOkClicked"/>
        </StackPanel>
    </Grid>
</PleasantWindow>
