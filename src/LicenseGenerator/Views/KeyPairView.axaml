<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LicenseGenerator.ViewModels"
             x:Class="LicenseGenerator.Views.KeyPairView"
             x:DataType="vm:MainViewModel">
    <ScrollViewer>
        <StackPanel Spacing="10" Margin="16">

            <TextBlock Text="Passphrase" FontWeight="SemiBold"/>
            <TextBox PasswordChar="●"
                     PlaceholderText="Passphrase für den Private Key…"
                     Text="{Binding Passphrase}" />

            <Button Content="Schlüsselpaar generieren"
                    Command="{Binding GenerateKeyPairCommand}" />

            <Separator />

            <TextBlock Text="Public Key" FontWeight="SemiBold"/>
            <TextBox Text="{Binding PublicKey}"
                     AcceptsReturn="True" Height="90"
                     FontFamily="Courier New" FontSize="11"
                     PlaceholderText="(leer – zuerst generieren oder laden)" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Laden…"     Command="{Binding LoadPublicKeyCommand}" />
                <Button Content="Speichern…" Command="{Binding SavePublicKeyCommand}" />
            </StackPanel>

            <TextBlock Text="Private Key (verschlüsselt)" FontWeight="SemiBold"/>
            <TextBox Text="{Binding PrivateKey}"
                     AcceptsReturn="True" Height="90"
                     FontFamily="Courier New" FontSize="11"
                     PlaceholderText="(leer – zuerst generieren oder laden)" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Laden…"     Command="{Binding LoadPrivateKeyCommand}" />
                <Button Content="Speichern…" Command="{Binding SavePrivateKeyCommand}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
