<PleasantWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="clr-namespace:LicenseGenerator.ViewModels"
                xmlns:views="clr-namespace:LicenseGenerator.Views"
                x:Class="LicenseGenerator.MainWindow"
                x:DataType="vm:MainViewModel"
                Title="License Generator" Icon="avares://LicenseGenerator/Assets/icon.png"
                Width="860" Height="620"
                MinWidth="680" MinHeight="500"
                WindowStartupLocation="CenterScreen">

    <NavigationView AlwaysOpen="True"
                    OpenPaneLength="200">
        <NavigationViewItem Header="Create license"
                            Title="Create license"
                            Icon="{x:Static MaterialIcons.Certificate}">
            <NavigationViewItem.Content>
                <views:GenerateLicenseView />
            </NavigationViewItem.Content>
        </NavigationViewItem>
        <NavigationViewItem Header="Validate &amp; inspect"
                            Title="Validate &amp; inspect"
                            Icon="{x:Static MaterialIcons.CheckCircle}">
            <NavigationViewItem.Content>
                <views:ValidateView />
            </NavigationViewItem.Content>
        </NavigationViewItem>
    </NavigationView>

</PleasantWindow>
